generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Note {
  id         String   @id @default(uuid())
  title      String   @default("Catatan Baru")
  content    String   @default("")
  summary    String   @default("")
  tags       String[] @default([])
  todo_list  Json     @default("[]")
  created_at DateTime @default(now())
  folder_id  String?
  folder     Folder?  @relation(fields: [folder_id], references: [id])

  @@map("notes")
}

model Folder {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now())
  parentId   String?  @map("parent_id")
  parent     Folder?  @relation("Subfolders", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders Folder[] @relation("Subfolders")
  notes      Note[]

  @@map("folders")
}

model ScheduledJob {
  id         String   @id @default(uuid())
  command    String
  actionType String
  payload    Json
  runAt      DateTime
  status     String   @default("pending")
  created_at DateTime @default(now())

  @@map("scheduled_jobs")
}

model Reminder {
  id             String   @id @default(uuid())
  title          String
  description    String?
  dateTime       DateTime
  notify1Day     Boolean  @default(true)
  notify1Hour    Boolean  @default(true)
  notifyExact    Boolean  @default(true)
  sent1Day       Boolean  @default(false)
  sent1Hour      Boolean  @default(false)
  sentExact      Boolean  @default(false)
  created_at     DateTime @default(now())
  whatsappNumber String?

  @@map("reminders")
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

model ChatMessage {
  id         String   @id @default(uuid())
  senderName String
  senderRole String
  message    String
  imageUrl   String?
  attribute  String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())

  @@map("chat_messages")
}

model ChatAttribute {
  id              String   @id @default(uuid())
  name            String   @unique
  options         Json     @default("[]")
  chatbotEnabled  Boolean  @default(false)
  createdAt       DateTime @default(now())
  groupAttributes Json     @default("[]")
  isGroup         Boolean  @default(false)
  quickText       String?

  @@map("chat_attributes")
}

model Reservation {
  id        String   @id @default(uuid())
  name      String
  dateTime  DateTime
  tableInfo String
  partySize Int
  dpAmount  Float    @default(0)
  menuList  String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@map("reservations")
}

model ChatAttributeHistory {
  id            String   @id @default(uuid())
  attributeId   String
  attributeName String
  optionId      String
  optionText    String
  status        String
  assignedTo    String?
  startDate     DateTime
  expiryDate    DateTime
  recordedAt    DateTime @default(now())
  isLate        Boolean  @default(false)
  lateByMinutes Int      @default(0)

  @@map("chat_attribute_histories")
}

model EmployeeContact {
  id         String   @id @default(uuid())
  name       String
  number     String   @unique
  created_at DateTime @default(now())

  @@map("employee_contacts")
}

model JobdeskReminder {
  id              String   @id @default(uuid())
  title           String
  description     String?
  isActive        Boolean  @default(true)
  lastRun         DateTime @default(now())
  whatsappNumber  String?
  employeeNames   String?
  created_at      DateTime @default(now())
  intervalMinutes Int      @default(60)

  @@map("jobdesk_reminders")
}
